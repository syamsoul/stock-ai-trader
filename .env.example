NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/main?schema=public

SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 */20 * * * *

# Broker modes:
# - Local mock paper: BROKER_PROVIDER=mock, BROKER_ENV=SIMULATE, ENABLE_LIVE_TRADING=false
# - Alpaca paper: BROKER_PROVIDER=alpaca, BROKER_ENV=SIMULATE, ENABLE_LIVE_TRADING=false
# - Alpaca live: BROKER_PROVIDER=alpaca, BROKER_ENV=REAL, ENABLE_LIVE_TRADING=true
# - Moomoo paper/demo: BROKER_PROVIDER=moomoo, BROKER_ENV=SIMULATE, ENABLE_LIVE_TRADING=false
# - Moomoo live: BROKER_PROVIDER=moomoo, BROKER_ENV=REAL, ENABLE_LIVE_TRADING=true
BROKER_PROVIDER=mock
BROKER_ENV=SIMULATE
ENABLE_LIVE_TRADING=false

ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
MOOMOO_OPEND_HOST=host.docker.internal
MOOMOO_OPEND_PORT=11111
MOOMOO_OPEND_SSL=false
MOOMOO_OPEND_KEY=
MOOMOO_SECURITY_FIRM=FUTU_MY
MOOMOO_ACCOUNT_ID_MY=
MOOMOO_ACCOUNT_ID_US=
MOOMOO_TRADE_UNLOCK_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_FALLBACK_MODE=mock
AI_MIN_CONFIDENCE=0.75
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
MARKET_DATA_PROVIDER=alpaca
WATCHLIST_US=AAPL,MSFT,NVDA,TSLA,AMD,META
AI_TRADING_STYLE=active
